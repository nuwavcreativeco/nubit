# Copy to .env.local and fill in what you need. Everything is optional.

# AI analyst — without this the deterministic analyst answers (same engine, templated text).
ANTHROPIC_API_KEY=
# ANALYST_MODEL=claude-opus-5-5
# ANALYST_ENGINE=local          # force the deterministic analyst even with a key

# Storage — defaults to a local JSON file at .data/db.json.
# Set both to store companies/scenarios/acquisitions in Supabase Postgres
# (apply supabase/migrations/0001_ecosystem.sql first).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# DATA_FILE=.data/db.json

# Authentication — set to require a shared password.
APP_PASSWORD=
AUTH_SECRET=
