# Two throwaway accounts on the TEST project, never production.
#
# Create them through the app's own sign-up page, note the handle each one
# gets, then fill this in and save it as .env.test (gitignored).
#
# The signed-in specs post days, place bids, send offers and book shoots for
# real. There is no rollback here the way there is in the SQL suite — which
# is exactly why these must not be production accounts.

E2E_BASE_URL=http://localhost:3000

E2E_SHOOTER_EMAIL=shooter@example.com
E2E_SHOOTER_PASSWORD=
E2E_SHOOTER_HANDLE=shooter_handle

E2E_CREATOR_EMAIL=creator@example.com
E2E_CREATOR_PASSWORD=
E2E_CREATOR_HANDLE=creator_handle
