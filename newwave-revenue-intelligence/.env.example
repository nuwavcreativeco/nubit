# Copy to .env (git-ignored, chmod 600). Never commit real values.

# Where your PRIVATE data lives. Keep it outside this code folder.
NWRI_WORKSPACE=~/NewWaveRevenueData

# Your name(s) as they appear in Instagram/Venmo exports (comma-separated),
# used to tell your messages apart from customers'.
NWRI_OWNER_NAMES=

NWRI_BASE_CURRENCY=USD

# Optional AI assistance (disabled until you also enable + consent in Settings).
ANTHROPIC_API_KEY=
NWRI_AI_MODEL=claude-opus-5-5
# Set to 1 to block ALL AI calls regardless of other settings.
NWRI_AI_DISABLED=0
# Set to 1 to turn off the server-side refusal fallback (on by default).
NWRI_AI_NO_FALLBACK=0
